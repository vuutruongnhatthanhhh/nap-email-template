{
  "manifest_version": 3,
  "name": "Nạp Email Template",
  "version": "0.1.0",
  "description": "Điền nhanh template email trong Gmail, gửi hàng loạt qua Bcc không lộ danh sách.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Nạp Email Template"
  },
  "background": {
    "service_worker": "src/background/worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/gmail.ts"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://mail.google.com/*", "https://*.supabase.co/*"],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
