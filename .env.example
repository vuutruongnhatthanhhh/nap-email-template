# Supabase — lấy từ Project Settings > API
# Dùng chung cho cả web/ (Next.js) và extension/ (Vite)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL của trang quản lý web (dùng trong popup extension để link sang dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini API key — dùng cho tính năng "Soạn bằng AI" trong form template.
# Lấy tại https://aistudio.google.com/apikey. Chỉ dùng ở server (web/), không
# có tiền tố NEXT_PUBLIC_ nên không lộ ra trình duyệt.
GEMINI_API_KEY=your-gemini-api-key
